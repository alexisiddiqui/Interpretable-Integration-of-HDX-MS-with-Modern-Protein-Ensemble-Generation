@article{wollenbergAvoidingScramblingMinimal2020,
  title = {Avoiding {{H}}/{{D Scrambling}} with {{Minimal Ion Transmission Loss}} for {{HDX-MS}}/{{MS-ETD Analysis}} on a {{High-Resolution Q-TOF Mass Spectrometer}}},
  author = {Wollenberg, Daniel T. Weltz and Pengelley, Stuart and Mouritsen, Jeppe Christian and Suckau, Detlev and J{\o}rgensen, Christian Isak and J{\o}rgensen, Thomas J. D.},
