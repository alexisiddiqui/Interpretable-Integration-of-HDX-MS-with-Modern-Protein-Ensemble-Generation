  doi = {10.2139/ssrn.6137054},
  urldate = {2026-10-28},
  abstract = {Although a protein's sequence is foretold in the genome, its conformation is sculpted by life history. Prions can encode and transmit an epigenetic record of such history between cells and individuals. Yet for the many protein-based epigenetic elements that do not form amyloid, mechanisms of structural replication remain unclear. Here we report that agglomeration of a folded RNA binding domain orchestrates propagation of the conserved non-amyloid prion [SMAUG+]. Mutagenesis informed by modeling suggests that self-assembly drives specificity for target RNAs and identifies variants that cure the prion in trans. Cryo-EM and free energy simulations reveal that structural polymorphism emerges from distinct isoenergetic binding modes of the RNA binding domain. Quantitative analysis of transcriptome-wide binding reveals specific combinations of RNAs that promote the emergence of distinct [SMAUG+] polymorphs. Our findings establish a colloidal physics mechanism for the self-assembly of ordered protein domains that enables complex contextualization in cellular memory and adaptation.},
  archiveprefix = {Social Science Research Network},
  langid = {english},
  keywords = {Biophysics,Cryo-electron microscopy,Epigenetics,Metadynamics,phase separation,Prions,RNA binding proteins}
}

