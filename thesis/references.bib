  pmcid = {PMC13596415},
  pmid = {42780058},
  file = {/Users/alexi/Zotero/storage/LECDVC47/Yan et al. - 2026 - Cryo-EM Structures of Infectious Low-Twist α-Synuclein Filaments in Lewy Bodies.pdf}
}

