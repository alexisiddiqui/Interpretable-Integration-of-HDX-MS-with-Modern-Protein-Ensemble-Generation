@article{fangHighthroughputHydrogenDeuterium2021,
  title = {High-Throughput Hydrogen Deuterium Exchange Mass Spectrometry ({{HDX-MS}}) Coupled with Subzero-Temperature Ultrahigh Pressure Liquid Chromatography ({{UPLC}}) Separation for Complex Sample Analysis},
  author = {Fang, Mulin and Wang, Zhe and {Cupp-Sutton}, Kellye A. and Welborn, Thomas and Smith, Kenneth and Wu, Si},
  year = 2021,
  month = jan,
  journal = {Analytica Chimica Acta},
  volume = {1143},
  pages = {65--72},
  issn = {1873-4324},
  doi = {10.1016/j.aca.2020.11.022},
  abstract = {Hydrogen deuterium exchange coupled with mass spectrometry (HDX-MS) is a powerful technique for the characterization of protein dynamics and protein interactions. Recent technological developments in the HDX-MS field, such as sub-zero LC separations, large-scale data analysis tools, and efficient protein digestion methods, have allowed for the application of HDX-MS to the analysis of multi protein systems in addition to pure protein analysis. Still, high-throughput HDX-MS analysis of complex samples is not widespread because the co-elution of peptides combined with increased peak complexity after labeling makes peak de-convolution extremely difficult. Here, for the first time, we evaluated and optimized long gradient subzero-temperature ultra-high-pressure liquid chromatography (UPLC) separation conditions for the HDX-MS analysis of complex protein samples such as E.~coli cell lysate digest. Under the optimized conditions, we identified 1419 deuterated peptides from 320 proteins at~-10~{$^\circ$}C, which is about 3-fold more when compared with a 15-min gradient separation under the same conditions. Interestingly, our results suggested that the peptides eluted late in the gradient are well-protected by peptide-column interactions at~-10~{$^\circ$}C so that peptides eluted even at the end of the gradient maintain high levels of deuteration. Overall, our study suggests that the optimized, sub-zero, long-gradient UPLC separation is capable of characterizing thousands of peptides in a single HDX-MS analysis with low back-exchange rates. As a result, this technique holds great potential for characterizing complex samples such as cell lysates using HDX-MS.},
  langid = {english},
  pmcid = {PMC8265693},
  pmid = {33384131},
  keywords = {Chromatography High Pressure Liquid,Deuterium Exchange Measurement,Escherichia coli,HDX-MS,High-throughput,Hydrogen,Hydrogen Deuterium Exchange-Mass Spectrometry,Proteomics,Sub-zero temperature,Temperature,UPLC separation},
  file = {/Users/alexi/Zotero/storage/E49HX8LI/Fang et al. - 2021 - High-throughput hydrogen deuterium exchange mass s.pdf}
}

