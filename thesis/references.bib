@article{hamuroEffectsIntramolecularIntermolecular2021,
  title = {The Effects of Intramolecular and Intermolecular Electrostatic Repulsions on the Stability and Aggregation of {{NISTmAb}} Revealed by {{HDX-MS}}, {{DSC}}, and {{nanoDSF}}},
  author = {Hamuro, Yoshitomo and Derebe, Mehabaw Getahun and Venkataramani, Sathya and Nemeth, Jennifer F.},
