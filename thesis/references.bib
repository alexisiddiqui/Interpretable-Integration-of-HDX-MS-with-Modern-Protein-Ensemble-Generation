@article{yaoNMRDeterminationAmide2008,
  title = {{{NMR Determination}} of {{Amide N-H Equilibrium Bond Length}} from {{Concerted Dipolar Coupling Measurements}}},
  author = {Yao, Lishan and V{\"o}geli, Beat and Ying, Jinfa and Bax, Ad},
  year = 2008,
  month = dec,
  journal = {J Am Chem Soc},
  volume = {130},
  number = {49},
  pages = {16518--16520},
  issn = {0002-7863},
  doi = {10.1021/ja805654f},
  urldate = {2024-09-25},
  abstract = {, The N-H bond length in backbone peptide groups of the protein GB3 has been studied by liquid crystal NMR, using five structurally conserved mutants of this protein. In the absence of additional information, the impact of dynamic fluctuations of the N-H vector orientation on the 15N-1H dipolar interaction cannot be separated from a change in N-H bond length. However, a change in N-H bond length directly impacts the orientation of C{$\prime$}-H vectors in the peptide group, and simultaneous analysis of 13C{$\prime$}-HN and 15N-HN residual dipolar couplings, measured under five different alignment orientations, permits modelfree determination of the average equilibrium N-H bond length in GB3, yielding rNHeq = 1.008 \textpm{} 0.006 \AA. Anharmonicity of the bond stretching results in a slightly longer time-averaged bond length {$<$}rNH{$>$} = 1.015 \textpm{} 0.006 \AA, and an effective bond length reff = {$<$}rNH-3{$>$}-1/3 = 1.023 \textpm{} 0.006 \AA{} pertinent for NMR relaxation analysis, not including the impact of zero-point or other angular fluctuations in N-H orientation. Using a reference frame defined by the backbone C{$\alpha$}-C{$\prime$} vectors of the protein, angular fluctuations for N-H vectors in elements of secondary structure are approximately 1.5 fold larger for out-of-plane fluctuations than motions within the peptide plane and not much larger than anticipated on the basis of quantum mechanical analysis of their zero-point librations.},
  pmcid = {PMC2670607},
  pmid = {19049453},
  file = {/Users/alexi/Zotero/storage/3ZT7GFYN/Yao et al. - 2008 - NMR Determination of Amide N-H Equilibrium Bond Le.pdf}
}

@article{yenMassSpectrometryCaptures2022,
  title = {Mass Spectrometry Captures Biased Signalling and Allosteric Modulation of a {{G-protein-coupled}} Receptor},
  author = {Yen, Hsin-Yung and Liko, Idlir and Song, Wanling and Kapoor, Parth and Almeida, Fernando and Toporowska, Joanna and Gherbi, Karolina and Hopper, Jonathan T. S. and Charlton, Steven J. and Politis, Argyris and Sansom, Mark S. P. and Jazayeri, Ali and Robinson, Carol V.},
